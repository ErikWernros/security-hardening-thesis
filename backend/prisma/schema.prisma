generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/**
 * Role for the user
 */
enum Role {
  Admin
  Assessor
  Viewer
}

model User {
  id          Int     @id @default(autoincrement())
  email       String  @unique
  displayName String?
  role        Role    @default(Viewer)

  // Relation: A user can submit many answers (Svar)
  svars Svar[]
}

model Del {
  id   Int    @id @default(autoincrement())
  kod  String @unique
  namn String

  // Relation: A 'Del' contains many 'Avsnitt'
  avsnitts Avsnitt[]
}

model Avsnitt {
  id   Int    @id @default(autoincrement())
  kod  String
  namn String

  delId Int
  del   Del @relation(fields: [delId], references: [id])

  // Back-relations
  omrades Omrade[]
  kravs   Krav[] // direct Avsnitt → Krav

  @@unique([kod, delId])
  @@index([delId])
}

/**
 * ===========
 * Område
 * ===========
 */
model Omrade {
  id   Int    @id @default(autoincrement())
  kod  String
  namn String

  // Område belongs to Avsnitt
  avsnittId Int
  avsnitt   Avsnitt @relation(fields: [avsnittId], references: [id])

  // Back-relations
  styckes Stycke[]
  kravs   Krav[]

  @@unique([kod, avsnittId])
  @@index([avsnittId])
}

model Stycke {
  id   Int    @id @default(autoincrement())
  kod  String
  namn String

  // ❗ Ahora Stycke pertenece a Område (no a Avsnitt)
  omradeId Int
  omrade   Omrade @relation(fields: [omradeId], references: [id])

  // Relation: A 'Stycke' contains many 'Krav'
  kravs Krav[]

  @@unique([kod, omradeId])
  @@index([omradeId])
}

model Krav {
  id        Int     @id @default(autoincrement())
  kod       String
  kravText  String
  anvisning String?

  // Rutas válidas (todas opcionales para migración segura):
  // 1) Avsnitt → Krav
  avsnittId Int?
  avsnitt   Avsnitt? @relation(fields: [avsnittId], references: [id])

  // 2) Avsnitt → Område → Krav
  omradeId Int?
  omrade   Omrade? @relation(fields: [omradeId], references: [id])

  // 3) Avsnitt → Område → Stycke → Krav
  styckeId Int?
  stycke   Stycke? @relation(fields: [styckeId], references: [id])

  // Relation: A 'Krav' can have many 'Svar'
  svars Svar[]

  // 👇 Uniqueness by scope (only applies when the field is not NULL)
  @@unique([avsnittId, kod])
  @@unique([omradeId, kod])
  @@unique([styckeId, kod])
  @@index([avsnittId])
  @@index([omradeId])
  @@index([styckeId])
}

model kravBedomningar {
  id      Int     @id @default(autoincrement())
  del_id  Int
  betyg   Float
  // ... andra fält
}

model Svar {
  id        Int      @id @default(autoincrement())
  betyg     Int?
  jaNej     Boolean?
  verifikat String?
  kommentar String?
  createdAt DateTime @default(now())

  kravId Int
  krav   Krav @relation(fields: [kravId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  // Ensure one answer per (krav, user)
  @@unique([kravId, userId])
}
